{
	"extends": "$app/tsconfig",
	"compilerOptions": {
		"strict": true,
		"types": ["$app/types", "node"]
	},
	"include": ["src", "worker", "vite.config.ts", "playwright.config.ts"],
	// Browser scripts shipped as-is via ?url; plain JavaScript, not compiled or type-checked
	"exclude": ["src/lib/client"]
}
