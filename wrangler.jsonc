{
	"name": "unionev-preview",
	"compatibility_date": "2026-10-27",
	"main": "worker/index.ts",
	"assets": {
		"directory": "./build",
		"not_found_handling": "404-page",
		// Only the API runs the Worker; every other path is served as a static asset
		"run_worker_first": ["/api/*"]
	},
	"vars": {
		"EMAIL_PROVIDER": "brevo",
		"ENQUIRY_TO": "grant@uevcl.com",
		"ENQUIRY_FROM": "Union EV <hello@unionev.co.uk>"
	}
}
