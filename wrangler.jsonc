{
	"name": "unionev-preview",
	// Union EV's Cloudflare account (Grant@uevcl.com's Account)
	"account_id": "e746411b2e407da7fb65515e39086183",
	"compatibility_date": "2026-10-27",
	// The live site is unionev.co.uk. www is attached too, but a Cloudflare Redirect Rule (dashboard)
	// sends it to unionev.co.uk before the Worker runs; if the rule is off, www still serves the site
	"routes": [
		{ "pattern": "unionev.co.uk", "custom_domain": true },
		{ "pattern": "www.unionev.co.uk", "custom_domain": true }
	],
	"main": "worker/index.ts",
	"assets": {
		"directory": "./build",
		"not_found_handling": "404-page",
		"binding": "ASSETS",
		// The API, and the home page (it is stamped with the time it was sent, worker/index.ts);
		// every other path is served as a static asset
		"run_worker_first": ["/api/*", "/"]
	},
	"vars": {
		"EMAIL_PROVIDER": "lettermint",
		"ENQUIRY_TO": "grant@uevcl.com",
		// Must be on a domain verified in Lettermint (unionev.co.uk)
		"ENQUIRY_FROM": "Grant Kennedy <hello@unionev.co.uk>",
		// Where replies to the visitor's confirmation email go (hello@ has no mailbox)
		"ENQUIRY_REPLY_TO": "grant@uevcl.com"
	},
	// Rate limits, per client IP unless noted (worker/env.ts). A window can only be 10 or 60 seconds
	"ratelimits": [
		// Enquiries that passed Turnstile
		{ "name": "ENQUIRY_LIMITER", "namespace_id": "1001", "simple": { "limit": 5, "period": 60 } },
		// Enquiries without Turnstile (no JavaScript, or it was blocked), so stricter
		{ "name": "PLAIN_LIMITER", "namespace_id": "1002", "simple": { "limit": 3, "period": 60 } },
		// Per recipient address, for the confirmation email
		{ "name": "RECIPIENT_LIMITER", "namespace_id": "1003", "simple": { "limit": 2, "period": 60 } }
	]
}
