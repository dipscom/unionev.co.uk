# Copy to .dev.vars for `npm run preview:cf`. Production secrets: `npx wrangler secret put <NAME>`.
LETTERMINT_API_TOKEN=lm_xxxxxxxx
# Cloudflare's always-passes test secret. Pairs with the test site key '1x00000000000000000000AA',
# which site.ts needs locally in place of the real key (see the comment there)
TURNSTILE_SECRET=1x0000000000000000000000000000000AA
# Signs the plain form's timestamp. Production: a long random string, e.g. `openssl rand -hex 32`
FORM_SECRET=dev-only-not-a-secret
# Local overrides of the vars in wrangler.jsonc, e.g. a mailbox you can read
# ENQUIRY_TO=you@example.com
# ENQUIRY_REPLY_TO=you@example.com
